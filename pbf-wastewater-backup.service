[Unit]
Description=Wastewater Dashboard nightly SQLite backup (keeps the newest 14)
After=network-online.target
[Service]
Type=oneshot
User=pbf-wastewater
Group=pbf-wastewater
WorkingDirectory=/opt/pbf-wastewater/web
Environment=PBF_BACKUP_DIR=/var/backups/pbf-wastewater-nightly
ExecStart=/usr/bin/python3 /opt/pbf-wastewater/web/web.py --backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pbf-wastewater /var/backups/pbf-wastewater-nightly
InaccessiblePaths=/etc/pbf-wastewater/dmweb.json
TimeoutStartSec=600
